{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SampleApp: discount",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-sample-app",
      "program": "${workspaceFolder}/fixtures/SampleApp/bin/Debug/net10.0/SampleApp.dll",
      "args": [
        "discount"
      ],
      "cwd": "${workspaceFolder}/fixtures/SampleApp",
      "console": "internalConsole",
      "stopAtEntry": false,
